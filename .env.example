# Copy to .env (which is gitignored). DO NOT commit .env.
#
# The teacher-owned sheet's ID (the long token from the URL, between /d/ and /edit).
# Kept in .env so the repo doesn't leak which specific sheet is being scraped.
SHEET_ID=REPLACE-ME

# Optional: specific tab to read. Find in the URL fragment "#gid=NNN".
# Default 0 = first tab.
SHEET_GID=0

# Override these only if you move the schoology-sync skill.
# GDOCS_COOKIES=/root/.openclaw/workspace/skills/schoology-sync/.gdocs_cookies.json
# GDOCS_AUTH_REFRESH=/root/.openclaw/workspace/skills/schoology-sync/scripts/gdocs_auth.py
